# Copy this file to .env and fill in the values.

# Required. Wikimedia asks every automated client to identify itself with a contact address.
CONTACT_EMAIL=your.name@warwick.ac.uk

# Where the SQLite database, saved page text and exports live.
DATA_DIR=data

# QS compiles its lists over roughly 10 years; roles that ended earlier are not counted as ON-LIST.
QS_WINDOW_YEARS=10

# --- Language model (optional) ---------------------------------------------
# Leave LLM_PROVIDER=none until the university's data-governance (IDG) review approves a provider and model.
# With none, evidence is extracted by fixed rules only.
# Providers: gemini | openai (OpenAI format; set LLM_BASE_URL for an approved gateway or other compatible service)
#            | anthropic | none
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Only for gateways and compatible services, e.g. https://your-approved-gateway.example.ac.uk/v1
LLM_BASE_URL=
# Set to api-key for gateways that expect that header instead of "Authorization: Bearer"
LLM_AUTH_HEADER=
# Stay under the provider's limits
LLM_RPM=8
LLM_DAILY_CAP=1200

# --- Web search (free tier, optional) -------------------------------------
# tavily | serper | none
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
# Hard monthly cap so the free allowance is never exceeded (Tavily free = 1,000 credits a month).
SEARCH_MONTHLY_CAP=900

# Pages fetched per shortlisted person (Wikipedia citations + search results).
MAX_PAGES_PER_PERSON=5
